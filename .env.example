# Optional. Public origin of the deployed web app, used to emit absolute
# canonical and og:url values. Leave unset for local development and for the
# Android / iOS builds, which are not served from a URL.
#
# VITE_SITE_URL=https://buspass.example.com

# Nothing secret belongs in this file. Every VITE_* value is compiled into
# the client bundle and into the Android and iOS app packages, where anyone
# who unpacks the app can read it.
